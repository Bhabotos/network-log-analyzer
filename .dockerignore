# Keep the build context small and the image free of local/dev files
venv/
.venv/
.git/
.gitignore
__pycache__/
*.pyc
.pytest_cache/

# Tests, data and generated output are not part of the runtime image
tests/
pytest.ini
requirements-dev.txt
logs/
reports/

# Docker files and docs
Dockerfile
docker-compose.yml
.dockerignore
README.md

# Prometheus/Grafana/Alertmanager config: mounted into their own containers,
# not this image
prometheus/
grafana/
alertmanager/
